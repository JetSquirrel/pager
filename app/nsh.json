{
  "name": "Pager",
  "id": "dev.pager.app",
  "version": "0.1.0",
  "build": 1,
  "appearance": "system",
  "theme": "theme.json",
  "web": {
    "host": "./host.js"
  },
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "host": [
      "pageInfo",
      "notify",
      "requestNotifications",
      "pushState",
      "pushEnable"
    ],
    "statusBar": true,
    "clipboard": true
  }
}
