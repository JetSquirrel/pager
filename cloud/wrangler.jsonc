{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pager",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The NSH web client (npm run build:web) is served at /app/; the API under /v1 always runs the Worker.
  "assets": { "directory": "./public", "run_worker_first": ["/v1/*"] },

  // Everything else lives in one SQLite-backed Durable Object: nothing to create by hand, runs on the free plan.
  "durable_objects": { "bindings": [{ "name": "PAGER", "class_name": "Pager" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pager"] }],

  "workers_dev": true,
  "routes": [{ "pattern": "pager.jetsquirrel.cloud", "custom_domain": true }],

  "vars": { "TUYA_ENDPOINT": "https://openapi.tuyaus.com", "CUSTOMER_NOTIFY": "off", "PUBLIC_URL": "https://pager.jetsquirrel.cloud" }
  // Secrets (wrangler secret put): BOOTSTRAP_TOKEN; TUYA_CLIENT_ID and TUYA_CLIENT_SECRET for Tuya devices.
  // CUSTOMER_NOTIFY: "off" is a dry run that reaches no customer; "on" really sends. See docs/alarm-permissions.md.
  // PUBLIC_URL is the address in links and integration URLs. *.workers.dev is poisoned on mainland China networks.
}
